POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=documind
POSTGRES_USER=documind_user
POSTGRES_PASSWORD=replace_with_a_strong_password

# MinIO Configuration
MINIO_ROOT_USER=documind_admin
MINIO_ROOT_PASSWORD=replace_with_a_strong_password

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=documind_app
MINIO_SECRET_KEY=YOUR_GENERATED_SECRET
MINIO_BUCKET=documind-documents
MINIO_SECURE=false
MINIO_REGION=us-east-1

MAX_UPLOAD_SIZE_BYTES=52428800

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ==================================
# AI Models
# ==================================

# Embedding model
EMBEDDING_MODEL=intfloat/multilingual-e5-small